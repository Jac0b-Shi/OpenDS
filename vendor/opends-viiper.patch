diff --git b/device/dualsense/microphone_buffer.go b/device/dualsense/microphone_buffer.go
new file mode 100644
index 0000000000000000000000000000000000000000..39703027057043d09b42727a2059564adfc741c2
--- /dev/null
+++ b/device/dualsense/microphone_buffer.go
@@ -0,0 +1,127 @@
+package dualsense
+
+import (
+	"encoding/binary"
+	"math"
+)
+
+// Caller holds d.mtx. Retain counters across host close/reopen, not PCM.
+func (d *DualSense) flushMicrophoneBuffer() {
+	if d.micBuffer != nil {
+		d.micUnderruns += d.micBuffer.underruns
+		d.micDropped += d.micBuffer.dropped
+		d.micBuffer = nil
+	}
+}
+
+func (d *DualSense) SetMicrophoneBufferMs(ms uint32) bool {
+	if ms < 16 || ms > 512 {
+		return false
+	}
+	d.mtx.Lock()
+	defer d.mtx.Unlock()
+	if d.micBufferMs != ms {
+		d.flushMicrophoneBuffer()
+		d.micBufferMs = ms
+	}
+	return true
+}
+
+// Queued sample frames, underrun events, dropped sample frames, rate in ppm.
+func (d *DualSense) MicrophoneBufferStats() [4]uint64 {
+	d.mtx.Lock()
+	defer d.mtx.Unlock()
+	stats := [4]uint64{0, d.micUnderruns, d.micDropped, 1000000}
+	if b := d.micBuffer; b != nil {
+		stats[0] = uint64(b.count)
+		stats[1] += b.underruns
+		stats[2] += b.dropped
+		if b.ratio != 0 {
+			stats[3] = uint64(math.Round(b.ratio * 1000000))
+		}
+	}
+	return stats
+}
+
+const (
+	micSamplesPerFrame = 48
+	micPreRollFrames   = 128 // milliseconds, independent of speaker/haptics latency
+	micQueueDepth      = 1024
+	micSampleCapacity  = micQueueDepth * micSamplesPerFrame
+)
+
+// microphoneBuffer bridges a bursty BT source clock to the USB frame clock.
+// Protected by DualSense.mtx; never sleeps or waits for the producer. Fixed
+// storage bounds latency and avoids per-enqueue allocations. The two channels
+// retain independent samples, sharing only the fractional read position.
+type microphoneBuffer struct {
+	samples               [micSampleCapacity][2]int16
+	head, count           int
+	position, ratio, mean float64
+	primed                bool
+	target                int
+	underruns, dropped    uint64
+}
+
+func (b *microphoneBuffer) push(frame []byte) {
+	if b.count+micSamplesPerFrame > micSampleCapacity {
+		b.head = (b.head + micSamplesPerFrame) % micSampleCapacity
+		b.count -= micSamplesPerFrame
+		b.position = 0
+		b.dropped += micSamplesPerFrame
+	}
+	for i := 0; i < micSamplesPerFrame; i++ {
+		at := (b.head + b.count) % micSampleCapacity
+		b.samples[at][0] = int16(binary.LittleEndian.Uint16(frame[i*4:]))
+		b.samples[at][1] = int16(binary.LittleEndian.Uint16(frame[i*4+2:]))
+		b.count++
+	}
+}
+
+func (b *microphoneBuffer) pop() []byte {
+	target := float64(b.target)
+	if target == 0 {
+		target = micPreRollFrames * micSamplesPerFrame
+	}
+	if !b.primed {
+		if b.count < int(target) {
+			return nil
+		}
+		b.primed, b.ratio, b.mean = true, 1, target
+	}
+	// Occupancy feedback handles independent clock rates, rather than
+	// periodically inserting zero frames when a slightly slower source drains
+	// even a large fixed FIFO. Smooth both the 10ms packet staircase and the
+	// correction; bound time scaling to +/-5%, with no sample block splices.
+	b.mean += (float64(b.count) - b.mean) * 0.02
+	error := b.mean - target
+	if math.Abs(error) < micSamplesPerFrame {
+		error = 0
+	}
+	wanted := max(0.95, min(1.05, 1+error/(48000*0.5)))
+	b.ratio += max(-0.00005, min(0.00005, wanted-b.ratio))
+	need := int(math.Ceil(b.position+micSamplesPerFrame*b.ratio)) + 1
+	if b.count < need {
+		b.primed = false
+		b.position = 0
+		b.underruns++
+		return nil // Re-prime once, instead of alternating tiny PCM/zero bursts.
+	}
+	frame := make([]byte, micFrameSize)
+	for i := 0; i < micSamplesPerFrame; i++ {
+		index := int(b.position)
+		fraction := b.position - float64(index)
+		a := b.samples[(b.head+index)%micSampleCapacity]
+		z := b.samples[(b.head+index+1)%micSampleCapacity]
+		for ch := 0; ch < 2; ch++ {
+			value := math.Round(float64(a[ch]) + (float64(z[ch])-float64(a[ch]))*fraction)
+			binary.LittleEndian.PutUint16(frame[i*4+ch*2:], uint16(int16(value)))
+		}
+		b.position += b.ratio
+	}
+	consumed := int(b.position)
+	b.position -= float64(consumed)
+	b.head = (b.head + consumed) % micSampleCapacity
+	b.count -= consumed
+	return frame
+}
diff --git b/device/dualsense/microphone_buffer_test.go b/device/dualsense/microphone_buffer_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..02464102f077235b5701282a905b9eea6c7e7504
--- /dev/null
+++ b/device/dualsense/microphone_buffer_test.go
@@ -0,0 +1,124 @@
+package dualsense
+
+import (
+	"context"
+	"encoding/binary"
+	"math"
+	"testing"
+
+	"github.com/DualSenseClient/VIIPER/usbip"
+	"github.com/stretchr/testify/require"
+)
+
+// Simulate source and USB clocks without sleeping or depending on OS timers.
+// A clear continuous source must not acquire silent 1ms holes at the USB end.
+func TestMicrophoneBurstJitterAndClockSkew(t *testing.T) {
+	for _, skew := range []float64{0.97, 1, 1.03} {
+		t.Run(fmtSkew(skew), func(t *testing.T) {
+			d, err := new(nil, false)
+			require.NoError(t, err)
+			openMic(t, d)
+			var next float64
+			var sample int
+			var previous int16
+			maxJump, silence := 0, 0
+			for ms := 0; ms < 30000; ms++ {
+				// 10ms decoded packets; every half second, hold one packet
+				// for 70ms then deliver the backlog, as a BT scheduler can.
+				held := ms%500 >= 400 && ms%500 < 470
+				if !held {
+					for float64(ms) >= next {
+						for frame := 0; frame < 10; frame++ {
+							pcm := make([]byte, 192)
+							for s := 0; s < 48; s++ {
+								v := int16(12000 * math.Sin(2*math.Pi*1000*float64(sample)/48000))
+								binary.LittleEndian.PutUint16(pcm[s*4:], uint16(v))
+								binary.LittleEndian.PutUint16(pcm[s*4+2:], uint16(-v))
+								sample++
+							}
+							require.True(t, d.QueueMicrophonePCM(pcm))
+						}
+						next += 10 / skew
+					}
+				}
+				got := d.HandleTransfer(context.Background(), 2, usbip.DirIn, nil)
+				require.Len(t, got, 192)
+				if ms < 250 {
+					continue
+				} // Initial pre-roll is intentionally silent.
+				nonzero := false
+				for s := 0; s < 48; s++ {
+					v := int16(binary.LittleEndian.Uint16(got[s*4:]))
+					r := int16(binary.LittleEndian.Uint16(got[s*4+2:]))
+					require.InDelta(t, -int(v), int(r), 1)
+					nonzero = nonzero || v != 0
+					if ms > 250 {
+						jump := int(math.Abs(float64(int(v) - int(previous))))
+						maxJump = max(maxJump, jump)
+					}
+					previous = v
+				}
+				if !nonzero {
+					silence++
+				}
+			}
+			require.Zero(t, silence, "continuous source acquired silent USB frames")
+			require.Less(t, maxJump, 2000, "discontinuous splice in a 1kHz tone")
+		})
+	}
+}
+
+func fmtSkew(skew float64) string {
+	if skew < 1 {
+		return "source_slow_3_percent"
+	}
+	if skew > 1 {
+		return "source_fast_3_percent"
+	}
+	return "equal_clocks"
+}
+
+func TestMicrophoneBufferConfigurationAndPersistentCounters(t *testing.T) {
+	d, err := new(nil, false)
+	require.NoError(t, err)
+	require.False(t, d.SetMicrophoneBufferMs(15))
+	require.False(t, d.SetMicrophoneBufferMs(513))
+	require.True(t, d.SetMicrophoneBufferMs(160))
+	openMic(t, d)
+	frame := make([]byte, 192)
+	for i := 0; i < 48; i++ {
+		binary.LittleEndian.PutUint16(frame[i*4:], 500)
+		binary.LittleEndian.PutUint16(frame[i*4+2:], 500)
+	}
+	for i := 0; i < 159; i++ {
+		require.True(t, d.QueueMicrophonePCM(frame))
+	}
+	require.Nil(t, d.popMicrophoneFrame())
+	require.True(t, d.QueueMicrophonePCM(frame))
+	require.Equal(t, frame, d.popMicrophoneFrame())
+	for i := 0; i < 400; i++ {
+		d.popMicrophoneFrame()
+	}
+	stats := d.MicrophoneBufferStats()
+	require.Equal(t, uint64(1), stats[1])
+	for i := 0; i < micQueueDepth+8; i++ {
+		require.True(t, d.QueueMicrophonePCM(frame))
+	}
+	require.Positive(t, d.MicrophoneBufferStats()[2])
+	d.setAltSetting(2, 0)
+	closed := d.MicrophoneBufferStats()
+	require.Zero(t, closed[0])
+	require.Equal(t, uint64(1), closed[1])
+	require.Positive(t, closed[2])
+	require.Nil(t, d.micBuffer)
+	require.True(t, d.SetMicrophoneBufferMs(192))
+	require.Equal(t, closed, d.MicrophoneBufferStats())
+	openMic(t, d)
+	require.True(t, d.SetMicrophoneBufferMs(512))
+	for i := 0; i < 511; i++ {
+		require.True(t, d.QueueMicrophonePCM(frame))
+	}
+	require.Nil(t, d.popMicrophoneFrame())
+	require.True(t, d.QueueMicrophonePCM(frame))
+	require.Equal(t, frame, d.popMicrophoneFrame())
+}
